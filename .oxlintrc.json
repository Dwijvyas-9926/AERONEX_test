{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "public/**",
    "dist/**"
  ],
  "overrides": [
    {
      "files": [
        "src/features/simulator/world/*.tsx",
        "src/features/digital-twin/TwinScene.tsx",
        "src/features/overview/HeroScene.tsx",
        "src/features/frame-studio/components/Frame3D.tsx"
      ],
      "rules": {
        "react/immutability": "off"
      }
    }
  ]
}
