{
  "name": "avion-gcs",
  "productName": "AERONEX",
  "version": "0.3.4",
  "description": "AERONEX Ground Station: design, set up, fly and review an ArduCopter drone.",
  "author": "Dwij Vyas",
  "homepage": "https://github.com/Dwijvyas-9926/AERONEX",
  "main": "desktop/main.bundle.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "vite build && npm run desktop:bundle && electron .",
    "desktop:dev": "npm run desktop:bundle && AERONEX_DEV_SERVER=http://localhost:5173 electron .",
    "dist:win": "vite build && npm run desktop:bundle && electron-builder --win --publish never",
    "desktop:bundle": "rolldown -c desktop/rolldown.config.mjs && node scripts/third-party-notices.mjs && node desktop/installer-licence.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/saira-semi-condensed": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.5.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.187.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "6.8.11",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.aeronex.groundstation",
    "productName": "AERONEX",
    "copyright": "Copyright © 2026 Dwij Vyas",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "dist/**/*",
      "desktop/main.bundle.cjs",
      "desktop/preload.cjs",
      "desktop/build/icon.png",
      "package.json",
      "!node_modules/**/*",
      "!dist/avion-sim-*.js",
      "!dist/avion-simulator.html",
      "!dist/vendor/**/*",
      "!dist/sw.js",
      "!dist/_headers",
      "!dist/_redirects"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/build/icon.ico",
      "artifactName": "AERONEX-Setup-${version}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AERONEX",
      "uninstallDisplayName": "AERONEX Ground Station",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "desktop/build/icon.ico",
      "uninstallerIcon": "desktop/build/icon.ico",
      "license": "desktop/build/license.txt"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dwijvyas-9926",
        "repo": "AERONEX",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "releaseInfo": {
      "releaseNotesFile": "desktop/build/release-notes.md"
    },
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "LICENSES/GPL-3.0.txt",
        "to": "LICENSES/GPL-3.0.txt"
      }
    ]
  },
  "license": "Apache-2.0"
}
